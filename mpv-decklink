#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
player="$base/build-mpv/mpv"
probe="$base/build/decklink-probe"
if [ -f "$base/mpv" ]; then
    player="$base/mpv"
    probe="$base/decklink-probe"
fi
if [ "${1:-}" = '--list-modes' ]; then
    exec "$probe"
fi
exec "$player" --no-config --vo=decklink --ao=decklink --hwdec=no "$@"
